# Copy OUTSIDE the source directory, for example /etc/flowzy/production.env (chmod 600).
# Use --env-file explicitly; do not reuse local .env or publish secrets in logs.
API_DOMAIN=api.example.com
FRONTEND_ORIGINS=https://app.example.com
FLOWZY_IMAGE_TAG=production
# Keep these two values in the same unused subnet if you change them.
FLOWZY_SUBNET=172.30.60.0/24
FLOWZY_PROXY_IP=172.30.60.2
POSTGRES_CA_CERT=/etc/flowzy/ca.crt
# Root Certificate is the path INSIDE the container. Use the VPC hostname from DigitalOcean.
# Single quotes around the full dotenv value prevent Compose interpolation of '$'.
DATABASE_CONNECTION_STRING='Host=private-db.example;Port=25060;Database=flowzy;Username=flowzy;Password=REPLACE_ME;SSL Mode=VerifyFull;Root Certificate=/etc/flowzy/ca.crt;Maximum Pool Size=20;Timeout=10'
# Generate independently, for example openssl rand -base64 48. Never use the local demo key.
JWT_SECRET_KEY=
GOOGLE_CLIENT_ID=
# Set both only for initial bootstrap on a new database. Remove after password change.
ADMIN_EMAIL=
ADMIN_PASSWORD=
